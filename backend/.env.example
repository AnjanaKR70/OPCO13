# ── SCAMഉണ്ടോ Backend Environment Variables ─────────────────

# Application
APP_NAME=SCAMഉണ്ടോ API
APP_VERSION=1.0.0
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/scamundo_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ML Prediction Service (Removed)

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10
